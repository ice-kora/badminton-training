{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://badminton-ai-coach.local/schemas/benchmark-package.json",
  "title": "MotionBenchmarkPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_code",
    "version",
    "handedness",
    "camera_view",
    "stages",
    "keyframes",
    "metrics",
    "common_error_refs",
    "linked_drill_codes",
    "verification_status",
    "source"
  ],
  "properties": {
    "skill_code": {
      "type": "string",
      "minLength": 1,
      "description": "Must match badminton_skills.code"
    },
    "skill_name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Semver-like label, e.g. 0.1.0"
    },
    "handedness": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "left",
        "right",
        "either",
        null
      ]
    },
    "camera_view": {
      "type": [
        "string",
        "null"
      ],
      "description": "Placeholder until capture protocol locked"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sort_order": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "keyframes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "stage_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "t_ms": {
            "type": [
              "number",
              "null"
            ],
            "description": "Optional timestamp placeholder; null until annotated"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "range_min": {
            "type": [
              "number",
              "null"
            ],
            "description": "Null until expert verification OR synthetic_demo/literature_cited with labeled range_kind"
          },
          "range_max": {
            "type": [
              "number",
              "null"
            ],
            "description": "Null until expert verification OR synthetic_demo/literature_cited with labeled range_kind"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "range_kind": {
            "type": [
              "string",
              "null"
            ],
            "description": "synthetic_demo | expert_verified | literature_mean_sd | literature_point_tolerance | literature_proxy_related_stroke; null for unverified shells"
          },
          "linked_error_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional common_error code linked to this metric"
          },
          "citations": {
            "type": [
              "array",
              "null"
            ],
            "description": "Required for numeric metrics when verification_status=literature_cited",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "doi_or_url",
                "extracted",
                "year"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "doi_or_url": {
                  "type": "string"
                },
                "extracted": {
                  "type": "string",
                  "description": "Quote or paraphrase of extracted statistic"
                },
                "year": {
                  "type": [
                    "integer",
                    "string"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "common_error_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "linked_drill_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "draft_unverified",
        "expert_pending",
        "verified",
        "synthetic_demo",
        "literature_cited"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "banner": {
      "type": [
        "string",
        "null"
      ],
      "description": "UI banner; required semantically for synthetic_demo and literature_cited"
    },
    "synthetic_keypoint_template": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional synthetic standard-motion keypoint sequence for demo compare",
      "additionalProperties": true
    }
  }
}
