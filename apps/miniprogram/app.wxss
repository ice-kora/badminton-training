page {
  background: #f1f5f9;
  color: #0f172a;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.container {
  padding: 24rpx 28rpx 48rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e2e8f0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.muted {
  color: #64748b;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #e2e8f0;
  color: #334155;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.tag.warn {
  background: #fef3c7;
  color: #92400e;
}

.tag.ok {
  background: #dcfce7;
  color: #166534;
}

.btn-primary {
  background: #0f172a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 28rpx;
  text-align: center;
}

.btn-ghost {
  background: #fff;
  color: #0f172a;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 28rpx;
  text-align: center;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 16rpx 0 12rpx;
}

.banner-note {
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  color: #9a3412;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}
