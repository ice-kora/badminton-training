<view class="container">
  <view class="banner-note">计划由规则模板生成，不是姿态 AI 分析结果。</view>

  <view wx:if="{{!plan}}" class="card">
    <view class="card-title">暂无计划</view>
    <view class="muted">完成水平测试后生成 7 日训练计划。</view>
    <view class="btn-primary" style="margin-top:20rpx;" bindtap="goTest">去水平测试</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="card-title">{{plan.title}}</view>
      <view class="muted">{{plan.start_date}} ~ {{plan.end_date}} · {{plan.level}}</view>
      <view class="muted" style="margin-top:8rpx;">{{plan.rationale}}</view>
    </view>

    <view class="card" wx:for="{{plan.days}}" wx:key="id">
      <view class="row">
        <view class="card-title" style="margin:0;">第 {{item.day_index}} 日</view>
        <text class="tag">{{item.duration_minutes}} 分钟</text>
      </view>
      <view>{{item.focus}}</view>
      <view class="muted">{{item.notes}}</view>
      <view class="btn-ghost" style="margin-top:16rpx;" bindtap="checkIn" data-day="{{item.id}}">打卡完成</view>
    </view>

    <view class="btn-ghost" bindtap="goTest">重新水平测试</view>
  </block>
</view>
