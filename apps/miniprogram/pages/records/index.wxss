.big-mini { font-size: 40rpx; font-weight: 700; }
.trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  min-height: 140rpx;
  margin-bottom: 8rpx;
}
.bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; }
.bar {
  width: 100%;
  max-width: 36rpx;
  background: #0f172a;
  border-radius: 8rpx 8rpx 0 0;
}
.bar-label { font-size: 18rpx; color: #64748b; margin-top: 4rpx; }
