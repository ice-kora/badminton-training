.check-row { margin-top: 8rpx; }
.check-pass { color: #166534; }
.check-fail { color: #b91c1c; }
.check-other { color: #64748b; }

.preview-disclaimer {
  margin-bottom: 16rpx;
}

.skeleton-canvas {
  width: 100%;
  max-width: 360px;
  height: 480px;
  background: #181820;
  border-radius: 12rpx;
  display: block;
  margin: 0 auto;
}

.scrub-row {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.compare-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 12rpx;
}

.compare-col {
  flex: 1;
  min-width: 0;
}

.compare-label {
  margin-bottom: 8rpx;
  text-align: center;
}

.compare-canvas {
  width: 100%;
  max-width: 160px;
  height: 240px;
  background: #181820;
  border-radius: 12rpx;
  display: block;
  margin: 0 auto;
}
