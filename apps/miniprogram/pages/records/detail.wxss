.check-row { margin-top: 8rpx; }
.check-pass { color: #166534; }
.check-fail { color: #b91c1c; }
.check-other { color: #64748b; }

.preview-disclaimer {
  margin-bottom: 16rpx;
}

.skeleton-canvas {
  width: 100%;
  max-width: 360px;
  height: 480px;
  background: #181820;
  border-radius: 12rpx;
  display: block;
  margin: 0 auto;
}

.scrub-row {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.compare-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 12rpx;
}

.compare-col {
  flex: 1;
  min-width: 0;
}

.compare-label {
  margin-bottom: 8rpx;
  text-align: center;
}

.compare-canvas {
  width: 100%;
  max-width: 160px;
  height: 240px;
  background: #181820;
  border-radius: 12rpx;
  display: block;
  margin: 0 auto;
}

.banner-synthetic {
  background: #fff7ed;
  border: 2rpx solid #f97316;
  color: #9a3412;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.dim-row {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.sev {
  font-weight: 700;
  margin-right: 12rpx;
}
.sev.P0 { color: #b91c1c; }
.sev.P1 { color: #c2410c; }
.sev.P2 { color: #a16207; }

.drill-cta {
  margin-top: 12rpx;
  color: #1d4ed8;
  font-weight: 600;
}

.score-delta {
  margin-bottom: 12rpx;
  font-weight: 600;
}
