<view class="container">
  <view class="banner-note">关键点可提取；评分未开放，不返回分数</view>
  <view class="muted" wx:if="{{loading}}">加载中…</view>
  <view class="muted" wx:elif="{{error}}">{{error}}</view>

  <block wx:if="{{video}}">
    <view class="card">
      <view class="card-title">{{video.skill_name}}</view>
      <view>文件：{{video.filename}}</view>
      <view class="muted">时长 {{durationText}} · {{video.orientation || '-'}} · {{createdText}}</view>
      <view class="muted">分辨率 {{video.width || '-'}}×{{video.height || '-'}}</view>
    </view>

    <view class="section-title">关键点 / 评分</view>
    <view class="card">
      <view class="row">
        <text>关键点</text>
        <text class="tag {{poseExtracted ? 'ok' : 'warn'}}">{{poseExtracted ? '关键点已提取' : '关键点未提取'}}</text>
      </view>
      <view class="muted" wx:if="{{poseExtracted && poseFrameCount}}">帧数 {{poseFrameCount}}（仅坐标序列）</view>
      <view class="row" style="margin-top:12rpx;">
        <text>评分</text>
        <text class="tag warn">评分未开放</text>
      </view>
      <view class="muted">error_code: ANALYSIS_NOT_IMPLEMENTED · 不返回动作正确性判断</view>
    </view>

    <view class="section-title">骨架预览</view>
    <view class="card">
      <view class="banner-note preview-disclaimer">仅关键点可视化，非评分</view>
      <block wx:if="{{poseExtracted}}">
        <canvas
          type="2d"
          id="skeletonCanvas"
          class="skeleton-canvas"
          style="width: {{canvasCssW}}px; height: {{canvasCssH}}px;"
        ></canvas>
        <view class="row scrub-row">
          <text class="muted">帧 {{previewFrame}} / {{previewMax}}</text>
          <text class="muted" wx:if="{{previewLoading}}">加载中…</text>
          <text class="muted" wx:elif="{{previewError}}">{{previewError}}</text>
        </view>
        <slider
          min="0"
          max="{{previewMax}}"
          value="{{previewFrame}}"
          step="1"
          show-value
          disabled="{{previewMax <= 0}}"
          bindchange="onPreviewScrub"
          bindchanging="onPreviewScrub"
        />
      </block>
      <view class="muted" wx:else>需先完成关键点提取后可预览骨架</view>
    </view>

    <view class="section-title">预检结果</view>
    <view class="card">
      <view class="row">
        <text>总体</text>
        <text class="tag {{precheckPassed ? '' : 'warn'}}">{{precheckPassed ? '通过' : '未通过/无数据'}}</text>
      </view>
      <view class="check-row" wx:for="{{checks}}" wx:key="id">
        <text class="{{item.cls}}">[{{item.status}}] {{item.id}} — {{item.message}}</text>
      </view>
      <view class="muted" wx:if="{{!checks.length}}">无预检明细</view>
    </view>

    <view class="section-title">分析任务</view>
    <view class="card" wx:for="{{jobs}}" wx:key="id">
      <view class="row">
        <text>任务 #{{item.id}}</text>
        <text class="tag {{item.status === 'pose_extracted' ? 'ok' : 'warn'}}">{{item.statusLabel}}</text>
      </view>
      <view class="muted">{{item.message || '评分尚未开放'}}</view>
      <view class="muted" wx:if="{{item.error_code}}">评分侧：{{item.error_code}}</view>
      <view class="muted" wx:if="{{item.scoring_status}}">scoring_status：{{item.scoring_status}}</view>
    </view>
    <view class="muted" wx:if="{{!jobs.length}}">暂无关联任务</view>
  </block>
</view>
