<view class="container">
  <view class="banner-synthetic" wx:if="{{isSyntheticDemo}}">⚠️ {{scoringBanner}}</view>
  <view class="banner-literature" wx:elif="{{isLiteratureCited}}">📚 {{scoringBanner}}</view>
  <view class="banner-note" wx:elif="{{!score}}">关键点可提取；无已发布标准库时评分不开放</view>
  <view class="banner-note" wx:else>{{video.notice || '已评分'}}</view>
  <view class="muted" wx:if="{{loading}}">加载中…</view>
  <view class="muted" wx:elif="{{error}}">{{error}}</view>

  <block wx:if="{{video}}">
    <view class="card">
      <view class="card-title">{{video.skill_name}}</view>
      <view>文件：{{video.filename}}</view>
      <view class="muted">时长 {{durationText}} · {{video.orientation || '-'}} · {{createdText}}</view>
      <view class="muted">分辨率 {{video.width || '-'}}×{{video.height || '-'}}</view>
      <view class="muted" wx:if="{{hasBaseline}}">复测关联基准 #{{video.baseline_video_id}}（{{baselineSummary.filename}}）</view>
      <view class="btn-primary" style="margin-top:20rpx;" bindtap="goRetest">针对此视频复测</view>
      <view class="muted" style="margin-top:8rpx;">复测可对比骨架；双方均已评分时显示分数差</view>
    </view>

    <view class="section-title">关键点 / 评分</view>
    <view class="card">
      <view class="row">
        <text>关键点</text>
        <text class="tag {{poseExtracted ? 'ok' : 'warn'}}">{{poseExtracted ? '关键点已提取' : '关键点未提取'}}</text>
      </view>
      <view class="muted" wx:if="{{poseExtracted && poseFrameCount}}">帧数 {{poseFrameCount}}</view>
      <view class="row" style="margin-top:12rpx;">
        <text>评分</text>
        <text class="tag {{score ? 'ok' : 'warn'}}">{{score ? ('总分 ' + score.overall_score) : '评分未开放'}}</text>
      </view>
      <view class="muted" wx:if="{{benchmarkKind}}">benchmark_kind：{{benchmarkKind}}</view>
      <view class="muted" wx:if="{{!score}}">error_code: ANALYSIS_NOT_IMPLEMENTED · awaiting_published_benchmark</view>
    </view>

    <block wx:if="{{score}}">
      <view class="banner-synthetic" wx:if="{{isSyntheticDemo}}">{{scoringBanner}}</view>
      <view class="banner-literature" wx:elif="{{isLiteratureCited}}">{{scoringBanner}}</view>
      <view class="section-title">分数拆解</view>
      <view class="card">
        <view class="dim-row" wx:for="{{dimensionList}}" wx:key="id">
          <text>{{item.name}}</text>
          <text class="tag">{{item.score}}</text>
        </view>
        <view class="muted" wx:if="{{!dimensionList.length}}">无维度分数</view>
      </view>

      <view class="section-title">主要问题（最多 3 条）</view>
      <view class="card" wx:for="{{problems}}" wx:key="error_code">
        <view class="row">
          <text class="sev {{item.severity}}">{{item.severity}}</text>
          <text>{{item.title}}</text>
        </view>
        <view class="muted" wx:if="{{item.metric_id}}">指标 {{item.metric_id}}</view>
        <view class="muted" wx:if="{{item.evidence.measured != null}}">
          测得 {{item.evidence.measured}} · 区间 [{{item.evidence.range_min}}, {{item.evidence.range_max}}]
        </view>
        <view wx:if="{{item.drills && item.drills.length}}" class="drill-cta" data-code="{{item.drills[0].code}}" bindtap="goDrill">
          推荐练习：{{item.drills[0].name}} →
        </view>
      </view>
      <view class="muted" wx:if="{{!problems.length}}">未检出显著问题</view>
    </block>


    <block wx:if="{{stageSegments.length}}">
      <view class="section-title">阶段时间轴</view>
      <view class="card">
        <view class="banner-note">{{stageNotice || '相对时序启发式切分，非专家标注'}}</view>
        <view class="stage-row" wx:for="{{stageSegments}}" wx:key="code">
          <view class="row">
            <text class="stage-name">{{item.name}}</text>
            <text class="muted">{{item.t0_ms}}–{{item.t1_ms}} ms</text>
          </view>
          <view class="muted" wx:if="{{item.delta_ms != null}}">相对模板 Δt {{item.deltaText}}</view>
        </view>
      </view>
    </block>

    <block wx:if="{{overlayAvailable}}">
      <view class="section-title">标准 vs 用户骨架叠加</view>
      <view class="card">
        <view class="banner-synthetic" wx:if="{{isSyntheticDemo || overlaySynthetic}}">⚠️ {{scoringBanner}}</view>
        <view class="banner-literature" wx:elif="{{isLiteratureCited}}">📚 {{scoringBanner}}</view>
        <view class="banner-note preview-disclaimer">非评分叠加 · 绿=标准 · 蓝=用户</view>
        <canvas
          type="2d"
          id="overlayCanvas"
          class="skeleton-canvas"
          style="width: {{overlayCssW}}px; height: {{overlayCssH}}px;"
        ></canvas>
        <view class="row scrub-row">
          <text class="muted">帧 {{overlayFrame}} / {{overlayMax}}</text>
          <text class="muted" wx:if="{{overlayStageName}}">阶段 {{overlayStageName}}</text>
          <text class="muted" wx:if="{{overlayLoading}}">加载中…</text>
          <text class="muted" wx:elif="{{overlayError}}">{{overlayError}}</text>
        </view>
        <slider
          min="0"
          max="{{overlayMax}}"
          value="{{overlayFrame}}"
          step="1"
          show-value
          disabled="{{overlayMax <= 0}}"
          bindchange="onOverlayScrub"
          bindchanging="onOverlayScrub"
        />
      </view>
    </block>

    <view class="section-title">骨架预览</view>
    <view class="card">
      <view class="banner-note preview-disclaimer">仅关键点可视化</view>
      <block wx:if="{{poseExtracted}}">
        <canvas
          type="2d"
          id="skeletonCanvas"
          class="skeleton-canvas"
          style="width: {{canvasCssW}}px; height: {{canvasCssH}}px;"
        ></canvas>
        <view class="row scrub-row">
          <text class="muted">帧 {{previewFrame}} / {{previewMax}}</text>
          <text class="muted" wx:if="{{previewLoading}}">加载中…</text>
          <text class="muted" wx:elif="{{previewError}}">{{previewError}}</text>
        </view>
        <slider
          min="0"
          max="{{previewMax}}"
          value="{{previewFrame}}"
          step="1"
          show-value
          disabled="{{previewMax <= 0}}"
          bindchange="onPreviewScrub"
          bindchanging="onPreviewScrub"
        />
      </block>
      <view class="muted" wx:else>需先完成关键点提取后可预览骨架</view>
    </view>

    <block wx:if="{{hasBaseline}}">
      <view class="section-title">复测对比</view>
      <view class="card">
        <view class="banner-synthetic" wx:if="{{isSyntheticDemo}}">{{scoringBanner}}</view>
        <view class="banner-literature" wx:elif="{{isLiteratureCited}}">{{scoringBanner}}</view>
        <view class="banner-note preview-disclaimer" wx:else>左右并排骨架</view>
        <view class="score-delta" wx:if="{{scoreDelta != null}}">
          分数差：{{scoreDeltaText}}（基准 {{baselineOverall}} → 当前 {{currentOverall}}）
        </view>
        <block wx:if="{{canCompare}}">
          <view class="compare-row">
            <view class="compare-col">
              <view class="muted compare-label">基准 #{{video.baseline_video_id}}</view>
              <canvas
                type="2d"
                id="compareBaselineCanvas"
                class="compare-canvas"
                style="width: {{compareCanvasCssW}}px; height: {{compareCanvasCssH}}px;"
              ></canvas>
            </view>
            <view class="compare-col">
              <view class="muted compare-label">当前复测</view>
              <canvas
                type="2d"
                id="compareCurrentCanvas"
                class="compare-canvas"
                style="width: {{compareCanvasCssW}}px; height: {{compareCanvasCssH}}px;"
              ></canvas>
            </view>
          </view>
          <view class="row scrub-row">
            <text class="muted">帧 {{compareFrame}} / {{compareMax}}</text>
            <text class="muted" wx:if="{{compareLoading}}">加载中…</text>
            <text class="muted" wx:elif="{{compareError}}">{{compareError}}</text>
          </view>
          <slider
            min="0"
            max="{{compareMax}}"
            value="{{compareFrame}}"
            step="1"
            show-value
            disabled="{{compareMax <= 0}}"
            bindchange="onCompareScrub"
            bindchanging="onCompareScrub"
          />
        </block>
        <view class="muted" wx:else>
          需基准与当前视频均完成关键点提取后可对比
          <text wx:if="{{baselineSummary && !baselineSummary.pose_extracted}}">（基准尚未提取）</text>
          <text wx:elif="{{!poseExtracted}}">（当前尚未提取）</text>
        </view>
      </view>
    </block>

    <view class="section-title">预检结果</view>
    <view class="card">
      <view class="row">
        <text>总体</text>
        <text class="tag {{precheckPassed ? '' : 'warn'}}">{{precheckPassed ? '通过' : '未通过/无数据'}}</text>
      </view>
      <view class="check-row" wx:for="{{checks}}" wx:key="id">
        <text class="{{item.cls}}">[{{item.status}}] {{item.id}} — {{item.message}}</text>
      </view>
      <view class="muted" wx:if="{{!checks.length}}">无预检明细</view>
    </view>

    <view class="section-title">分析任务</view>
    <view class="card" wx:for="{{jobs}}" wx:key="id">
      <view class="row">
        <text>任务 #{{item.id}}</text>
        <text class="tag {{item.status === 'scored' || item.status === 'pose_extracted' ? 'ok' : 'warn'}}">{{item.statusLabel}}</text>
      </view>
      <view class="muted">{{item.message || ''}}</view>
      <view class="muted" wx:if="{{item.error_code}}">评分侧：{{item.error_code}}</view>
      <view class="muted" wx:if="{{item.scoring_status}}">scoring_status：{{item.scoring_status}}</view>
      <view class="muted" wx:if="{{item.benchmark_kind}}">benchmark_kind：{{item.benchmark_kind}}</view>
    </view>
    <view class="muted" wx:if="{{!jobs.length}}">暂无关联任务</view>
  </block>
</view>
