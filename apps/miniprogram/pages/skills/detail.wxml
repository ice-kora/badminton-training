<view class="container" wx:if="{{skill}}">
  <view class="card">
    <view class="card-title">{{skill.name}}</view>
    <view class="muted">{{skill.summary}}</view>
    <view style="margin-top:12rpx;" wx:if="{{skillStatusLabel}}">
      <text class="tag warn">{{skillStatusLabel}}</text>
    </view>
  </view>

  <view class="section-title">动作阶段</view>
  <view class="card" wx:for="{{skill.stages}}" wx:key="id">
    <view class="card-title">{{index + 1}}. {{item.name}}</view>
    <view class="muted">{{item.description}}</view>
  </view>

  <view class="section-title">教学内容</view>
  <view class="card" wx:for="{{contentBlocks}}" wx:key="id">
    <view class="card-title">{{item.title}}</view>
    <view>{{item.body}}</view>
    <view class="tag warn" style="margin-top:8rpx;" wx:if="{{item.statusLabel}}">{{item.statusLabel}}</view>
  </view>

  <view class="btn-primary" bindtap="goViewer3d">3D 标准动作（演示）</view>
  <view class="btn-ghost" style="margin-top:16rpx;" bindtap="goFilming">拍摄指导</view>
  <view class="muted awaiting" style="margin-top:20rpx;">{{awaitingHint}}</view>
</view>
