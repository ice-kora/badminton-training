<view class="container">
  <view class="banner-note">拍摄引导为产品 UX 指引，不是关节角度数值标准。上传仅做质量预检。</view>
  <block wx:for="{{guides}}" wx:key="id">
    <view class="card">
      <view class="card-title">参考画面</view>
      <view class="ref-frame">
        <view class="sil-head"></view>
        <view class="sil-body"></view>
        <view class="sil-legs"></view>
        <view class="ref-caption">全身入框 · 竖屏 · 球拍可见</view>
      </view>
      <view class="muted">机位：{{item.camera_angle}}</view>
      <view class="muted">{{item.distance_hint}} · {{item.height_hint}} · {{item.orientation}}</view>

      <view class="section-title">3 条关键检查</view>
      <view class="key-check" wx:for="{{item.keyChecks}}" wx:for-item="k" wx:key="*this">✓ {{k}}</view>

      <view class="section-title row" bindtap="toggleChecklist" data-id="{{item.id}}">
        <text>完整清单</text>
        <text class="muted">{{item.checklistOpen ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{item.checklistOpen}}">
        <view wx:for="{{item.checklist}}" wx:for-item="c" wx:key="*this">· {{c}}</view>
        <view class="muted" style="margin-top:12rpx;">{{item.lighting_notes}}</view>
        <view class="muted">时长 {{item.duration_range_sec[0]}}–{{item.duration_range_sec[1]}} 秒 · 短边 ≥ {{item.min_resolution.min_short_side}}</view>
      </block>
      <view class="tag warn" style="margin-top:8rpx;">{{item.verification_status}}</view>
    </view>
  </block>
  <view class="btn-primary" wx:if="{{skillId}}" bindtap="startRecord">开始录制 / 选择视频</view>
  <view class="muted" wx:if="{{error}}">{{error}}</view>
</view>
