<view class="container">
  <view class="banner-note">拍摄引导为产品 UX 指引，不是关节角度数值标准。上传仅做质量预检。</view>

  <view class="card">
    <view class="card-title">持拍手</view>
    <view class="hand-toggle">
      <view class="hand-btn {{handedness==='right'?'on':''}}" data-hand="right" bindtap="setHandedness">右手</view>
      <view class="hand-btn {{handedness==='left'?'on':''}}" data-hand="left" bindtap="setHandedness">左手</view>
    </view>
    <view class="muted">默认右手；可随时切换，录制页同步。</view>
  </view>

  <view class="card">
    <view class="card-title">推荐机位 · 俯视示意</view>
    <view class="angle-map {{handedness==='left'?'mirror':''}}">
      <view class="court">
        <view class="net"></view>
        <view class="player-dot"></view>
        <view class="player-label">球员</view>
        <view class="phone-mark">
          <view class="phone-body"></view>
          <view class="phone-ray"></view>
        </view>
        <view class="phone-label">手机 · 后侧约 45°</view>
      </view>
    </view>
    <view class="angle-copy">
      <view>· 手机放在持拍手同侧的后斜约 45°，约腰高，全身入画。</view>
      <view wx:if="{{handedness==='right'}}">· 右手持拍：机位在球员右后方（示意已按右手默认）。</view>
      <view wx:else>· 左手持拍：请镜像放置——机位在球员左后方。</view>
      <view class="muted" style="margin-top:8rpx;">2D 评分为图像平面近似（image-plane proxy），机位越好越可信；本示意不是真 3D 重建。</view>
    </view>
  </view>

  <block wx:for="{{guides}}" wx:key="id">
    <view class="card">
      <view class="card-title">参考画面</view>
      <view class="ref-frame">
        <view class="sil-head"></view>
        <view class="sil-body"></view>
        <view class="sil-legs"></view>
        <view class="ref-caption">全身入框 · 竖屏 · 球拍可见</view>
      </view>
      <view class="muted">机位：{{item.camera_angle}}</view>
      <view class="muted">{{item.distance_hint}} · {{item.height_hint}} · {{item.orientation}}</view>

      <view class="section-title">拍摄提示（非强制勾选）</view>
      <view class="key-check" wx:for="{{item.keyChecks}}" wx:for-item="k" wx:key="*this">· {{k}}</view>
      <view class="muted" style="margin-top:8rpx;">现场拍摄最长 60 秒；相册选择最长 60 秒；服务端 5–60 秒。</view>

      <view class="section-title row" bindtap="toggleChecklist" data-id="{{item.id}}">
        <text>更多说明</text>
        <text class="muted">{{item.checklistOpen ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{item.checklistOpen}}">
        <view wx:for="{{item.checklist}}" wx:for-item="c" wx:key="*this">· {{c}}</view>
        <view class="muted" style="margin-top:12rpx;">{{item.lighting_notes}}</view>
        <view class="muted">时长 {{item.duration_range_sec[0]}}–{{item.duration_range_sec[1]}} 秒 · 短边 ≥ {{item.min_resolution.min_short_side}}</view>
      </block>
      <view class="tag warn" style="margin-top:8rpx;" wx:if="{{item.statusLabel}}">{{item.statusLabel}}</view>
    </view>
  </block>
  <view class="btn-primary" wx:if="{{skillId}}" bindtap="startRecord">开始录制 / 选择视频</view>
  <view class="muted" wx:if="{{error}}">{{error}}</view>
</view>
