<view class="container result-page">
  <view class="banner-synthetic" wx:if="{{isSyntheticDemo}}">⚠️ {{banner}}</view>
  <view class="banner-literature" wx:elif="{{isLiteratureCited}}">📚 {{banner}}</view>
  <view class="banner-note" wx:else>分析过程可查看；分数仅在已发布标准库评分后出现，无模拟分。</view>

  <!-- U4 stepper -->
  <view class="card stepper-card">
    <view class="card-title">分析进度</view>
    <view class="stepper">
      <view class="step {{stepClass.uploaded}}">上传</view>
      <view class="step-line"></view>
      <view class="step {{stepClass.queued}}">预检/排队</view>
      <view class="step-line"></view>
      <view class="step {{stepClass.extracting}}">提取</view>
      <view class="step-line"></view>
      <view class="step {{stepClass.pose}}">关键点</view>
      <view class="step-line"></view>
      <view class="step {{stepClass.final}}">{{finalStepLabel}}</view>
    </view>
    <view class="muted" style="margin-top:12rpx;">{{jobMessage || ('进度：' + (jobStatus || '…'))}}</view>

    <!-- P2.2 wait-state enrichment (no fake scores) -->
    <block wx:if="{{waiting}}">
      <view class="wait-breathe" aria-hidden="true">
        <view class="breathe-bar"></view>
      </view>
      <view class="wait-tip-card">
        <view class="wait-tip-label">等待时小贴士</view>
        <view class="wait-tip-text">{{waitTip}}</view>
      </view>
      <view class="subscribe-soft" wx:if="{{subscribeSoftHint}}">{{subscribeSoftHint}}</view>
    </block>
  </view>

  <!-- U2 scored comfort -->
  <block wx:if="{{scored && score}}">
    <view class="card score-hero">
      <view class="hero-kicker">本次评分</view>
      <view class="big-score">{{score.overall_score}}</view>
      <view class="primary-sentence">{{primarySentence}}</view>
    </view>

    <view class="section-title">主要问题（最多 3 条）</view>
    <view class="card issue-card" wx:for="{{issues}}" wx:key="error_code">
      <view class="row">
        <text class="sev {{item.severity}}">{{item.severity}}</text>
        <text class="issue-title">{{item.title}}</text>
      </view>
      <view class="muted" wx:if="{{item.metric_id}}">指标 {{item.metric_id}}</view>
      <view class="muted" wx:if="{{item.drills && item.drills.length}}">推荐：{{item.drills[0].name || item.drills[0].code}}</view>
    </view>
    <view class="muted" wx:if="{{!issues.length}}">未检出显著问题，可再录一段巩固。</view>
  </block>

  <!-- U5 player -->
  <view class="card" wx:if="{{videoId}}">
    <view class="card-title">回放</view>
    <video
      id="resultPlayer"
      src="{{videoUrl}}"
      controls
      playback-rate="{{playbackRate}}"
      style="width:100%;"
      bindtimeupdate="onTimeUpdate"
    ></video>
    <view class="player-controls">
      <view class="rate-btn {{playbackRate===1?'on':''}}" data-rate="1" bindtap="setRate">1x</view>
      <view class="rate-btn {{playbackRate===0.5?'on':''}}" data-rate="0.5" bindtap="setRate">0.5x</view>
      <view class="rate-btn {{playbackRate===0.25?'on':''}}" data-rate="0.25" bindtap="setRate">0.25x</view>
      <view class="rate-btn" data-delta="-2" bindtap="seekBy">-2s</view>
      <view class="rate-btn" data-delta="2" bindtap="seekBy">+2s</view>
    </view>
    <view class="row" style="margin-top:12rpx;" wx:if="{{overlayAvailable || poseExtracted}}">
      <view class="btn-ghost tiny" bindtap="goDetail">并排对比（主）</view>
      <view class="btn-ghost tiny" bindtap="toggleOverlay">{{showOverlay ? '关闭骨架提示' : '骨架叠加（可选）'}}</view>
    </view>
    <view class="muted" wx:if="{{showOverlay}}">骨架默认关闭；详情页可选手动打开叠加。</view>
  </view>

  <view class="muted" wx:if="{{error}}">{{error}}</view>


  <!-- Drill demo loop -->
  <view class="card" wx:if="{{scored && (demoUrl || ctaDrill)}}">
    <view class="card-title">看示范</view>
    <block wx:if="{{demoUrl}}">
      <image class="demo-media" src="{{demoUrl}}" mode="aspectFit" lazy-load />
      <view class="muted honesty">示意动图（非真人教练）</view>
    </block>
    <view class="demo-placeholder" wx:else bindtap="goDrill">
      <text class="muted">看示范</text>
      <text class="muted honesty">示意动图暂缺 · 非真人教练</text>
    </view>
  </view>


  <!-- B1 watermarked share card (Moments image) -->
  <view class="card share-card-block" wx:if="{{scored && score}}">
    <view class="card-title">分享装逼卡</view>
    <view class="muted">生成带水印的成绩图，可保存相册或转发朋友圈。</view>
    <view class="share-actions">
      <view class="btn-primary" bindtap="onShareCard">分享装逼卡</view>
      <view class="btn-ghost soft-cta" bindtap="onRemoveWatermarkHook">去水印高清导出 · 即将开放</view>
    </view>
  </view>

  <!-- off-screen canvas for share image (legacy canvas-id) -->
  <canvas
    canvas-id="shareCard"
    class="share-canvas"
    style="width: {{shareCanvasW}}px; height: {{shareCanvasH}}px;"
    width="{{shareCanvasW}}"
    height="{{shareCanvasH}}"
  ></canvas>

  <!-- sticky CTAs -->
  <view class="sticky-cta">
    <view class="btn-primary" bindtap="goDrill">{{drillLabel}}</view>
    <view class="btn-ghost" bindtap="goRetest">再录对比</view>
  </view>
</view>
