<view class="container">
  <view class="banner-note">关键点可异步提取；评分未开放，不返回分数。</view>
  <view class="card">
    <view class="card-title">上传成功</view>
    <view>视频 ID：{{videoId}}</view>
    <view>任务 ID：{{jobId}}</view>
    <view class="row" style="margin-top:12rpx;">
      <text class="tag ok">{{poseLabel}}</text>
      <text class="tag warn">{{scoringLabel}}</text>
    </view>
    <view class="tag warn" style="margin-top:12rpx;">{{jobStatus}}</view>
    <view class="muted" style="margin-top:12rpx;">{{jobMessage}}</view>
    <view class="muted" wx:if="{{errorCode}}">error_code: {{errorCode}}</view>
  </view>
  <view class="btn-primary" bindtap="goDetail" style="margin-bottom:16rpx;">查看视频详情</view>
  <view class="btn-ghost" bindtap="goHistory" style="margin-bottom:16rpx;">查看上传历史</view>
  <view class="btn-ghost" bindtap="backSkill">返回</view>
  <view class="muted" wx:if="{{error}}">{{error}}</view>
</view>
