.silhouette-card .silhouette {
  height: 360rpx;
  margin: 16rpx 0;
  border: 2rpx dashed #94a3b8;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
}
.sil-head {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #cbd5e1;
}
.sil-body {
  width: 100rpx;
  height: 140rpx;
  margin-top: 8rpx;
  border-radius: 16rpx;
  background: #94a3b8;
}
.sil-legs {
  width: 80rpx;
  height: 100rpx;
  margin-top: 8rpx;
  border-radius: 8rpx;
  background: #64748b;
}
.check-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
}
.fail-item {
  color: #b91c1c;
  font-size: 26rpx;
  margin-top: 8rpx;
}
