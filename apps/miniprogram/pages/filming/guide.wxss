.ref-frame {
  height: 360rpx;
  margin: 16rpx 0 20rpx;
  border: 2rpx dashed #94a3b8;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f8fafc, #e2e8f0);
  position: relative;
}
.sil-head {
  width: 64rpx; height: 64rpx; border-radius: 50%; background: #cbd5e1;
}
.sil-body {
  width: 100rpx; height: 140rpx; margin-top: 8rpx; border-radius: 16rpx; background: #94a3b8;
}
.sil-legs {
  width: 80rpx; height: 100rpx; margin-top: 8rpx; border-radius: 8rpx; background: #64748b;
}
.ref-caption {
  position: absolute; bottom: 16rpx; font-size: 22rpx; color: #475569;
}
.key-check {
  padding: 12rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  border-bottom: 1rpx solid #f1f5f9;
}

.hand-toggle {
  display: flex;
  gap: 16rpx;
  margin: 12rpx 0;
}
.hand-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #f1f5f9;
  color: #334155;
  font-size: 28rpx;
}
.hand-btn.on {
  background: #2563eb;
  color: #fff;
}

/* Best camera angle mini-map (top-down, semi-transparent) */
.angle-map {
  margin: 16rpx 0 12rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(241, 245, 249, 0.85);
  border: 1rpx solid #e2e8f0;
}
.angle-map.mirror .court {
  transform: scaleX(-1);
}
.angle-map.mirror .player-label,
.angle-map.mirror .phone-label {
  transform: scaleX(-1);
}
.court {
  position: relative;
  height: 320rpx;
  margin: 16rpx;
  border: 2rpx solid rgba(148, 163, 184, 0.55);
  border-radius: 12rpx;
  background: linear-gradient(180deg, rgba(226, 232, 240, 0.5), rgba(203, 213, 225, 0.35));
}
.net {
  position: absolute;
  left: 8%;
  right: 8%;
  top: 48%;
  height: 0;
  border-top: 2rpx dashed rgba(100, 116, 139, 0.55);
}
.player-dot {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(37, 99, 235, 0.55);
  left: 46%;
  top: 62%;
}
.player-label {
  position: absolute;
  left: 42%;
  top: 76%;
  font-size: 20rpx;
  color: #475569;
}
.phone-mark {
  position: absolute;
  right: 14%;
  bottom: 10%;
  width: 80rpx;
  height: 80rpx;
}
.phone-body {
  width: 28rpx;
  height: 44rpx;
  border-radius: 6rpx;
  background: rgba(15, 23, 42, 0.55);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  transform: rotate(-35deg);
  margin-left: 20rpx;
}
.phone-ray {
  position: absolute;
  left: -10rpx;
  top: -8rpx;
  width: 0;
  height: 0;
  border-left: 36rpx solid transparent;
  border-right: 36rpx solid transparent;
  border-bottom: 70rpx solid rgba(59, 130, 246, 0.18);
  transform: rotate(20deg);
}
.phone-label {
  position: absolute;
  right: 8%;
  bottom: 2%;
  font-size: 20rpx;
  color: #334155;
}
.angle-copy {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.55;
}
.angle-copy strong {
  font-weight: 600;
}
